# ===== 应用 =====
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/adaptive.log

# ===== 交易标的与模式 =====
SYMBOLS=SOLUSDT
# 纸面交易=true 模拟成交;false 需要配置真实 API Key
PAPER_TRADING=true
PAPER_INITIAL_CASH=100000
PAPER_FEE_RATE=0.001

# ===== 数据库(生产切 MySQL) =====
# 开发: sqlite+aiosqlite:///./adaptive.db
# 生产: mysql+aiomysql://root:password@localhost:3306/adaptive_trading
DATABASE_URL=sqlite+aiosqlite:///./adaptive.db

# ===== Redis(可选) =====
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ===== Web =====
API_HOST=0.0.0.0
API_PORT=8800

# ===== 币安 =====
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ===== AI Advisor =====
# 供应商选择: openai / qwen / deepseek(均为 OpenAI 兼容协议)
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_INTERVAL_SECONDS=86400
# 通用覆盖(留空则用各供应商默认 base_url 与下方 .env key)
AI_BASE_URL=
AI_API_KEY=
# 各供应商 Key(默认 base_url 已内置, 可在此覆盖)
OPENAI_API_KEY=
OPENAI_BASE_URL=
QWEN_API_KEY=
QWEN_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
