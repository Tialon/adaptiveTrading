# ===== 应用 =====
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/adaptive.log
TZ=UTC

# ===== 交易标的与模式 =====
SYMBOLS=SOLUSDT
# 纸面交易=true 模拟成交;false 需要配置真实 API Key
PAPER_TRADING=true
PAPER_INITIAL_CASH=100000
PAPER_FEE_RATE=0.001

# ===== 数据库(SQLite 单机生产) =====
# 本机: sqlite+aiosqlite:///./adaptive.db(相对路径, 落在运行目录)
# 容器: sqlite+aiosqlite:////app/data/adaptive.db(绝对路径, 由 docker-compose 覆盖到挂载卷)
DATABASE_URL=sqlite+aiosqlite:///./adaptive.db

# ===== 版本追踪(V11.8 §7) =====
# IMAGE_TAG: docker-compose 用 git_sha 给镜像打 tag(如 31262e91), 使「Pi→容器→镜像→git SHA」可追踪。
# GIT_SHA: 构建时打进镜像 ENV(容器内无 .git, 运行时 git rev-parse 会空), 供启动日志/主网自检/证据。
# 生产部署时设 IMAGE_TAG=<git_sha>; GIT_SHA 通常由构建命令 --build-arg GIT_SHA=$(git rev-parse HEAD) 注入,
# 亦可在此显式写死以在无 git 的部署目录使用。
IMAGE_TAG=local
GIT_SHA=

# ===== 构建源镜像/依赖源(docker compose build 的 build args; 防火墙/镜像站环境覆盖) =====
# 默认走 docker.io / pypi.org; 被墙环境(如某些树莓派网络)改为镜像站:
#   PYTHON_BASE=docker.1ms.run/library/python:3.13-slim
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
#   UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/
PYTHON_BASE=python:3.13-slim
PIP_INDEX_URL=https://pypi.org/simple
UV_DEFAULT_INDEX=https://pypi.org/simple

# ===== Redis(可选, 默认关) =====
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ===== Web =====
# 本机开发回环: 127.0.0.1;容器/局域网部署需 0.0.0.0。
# 注意: API_HOST 非回环(0.0.0.0/局域网 IP)时, 必须设非空 WEB_ADMIN_TOKEN 保护写接口,
# 否则 validate() 直接拒绝启动(fail-closed)。
API_HOST=0.0.0.0
API_PORT=8800
WEB_ADMIN_TOKEN=

# ===== 币安 =====
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 主网守卫: BINANCE_TESTNET=false(连主网)时必须显式设 true, 否则启动拦截(默认禁主网)
LIVE_TRADING_CONFIRM=

# ===== 测试网真实执行(V11.7 闸门) =====
# 真实(非纸面)测试网下单须同时: PAPER_TRADING=false + BINANCE_TESTNET=true +
# RUN_TESTNET_TRADING=1 + LIVE_TRADING_CONFIRM 非 true + 测试网 key/secret 齐备, 否则 BLOCKED。
RUN_TESTNET_TRADING=

# ===== 主网就绪自检(V11.8 §21) =====
# 主网启动前强制自检; 任一不满足 BLOCKED。MAINNET_API_SCOPE_CONFIRM 默认 false → 主网必被拦,
# 须人工确认主网 API key 权限(仅 Spot、关提现/资金转移)后显式置 true。
MAINNET_READINESS_ENABLED=true
MAINNET_API_SCOPE_CONFIRM=false

# ===== AI Advisor =====
# 供应商选择: openai / qwen / deepseek(均为 OpenAI 兼容协议)
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_INTERVAL_SECONDS=86400
# 通用覆盖(留空则用各供应商默认 base_url 与下方 .env key)
AI_BASE_URL=
AI_API_KEY=
# 各供应商 Key(默认 base_url 已内置, 可在此覆盖)
OPENAI_API_KEY=
OPENAI_BASE_URL=
QWEN_API_KEY=
QWEN_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
