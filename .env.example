# ===== 应用 =====
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/adaptive.log

# ===== 交易标的与模式 =====
SYMBOLS=BTCUSDT
# 纸面交易=true 模拟成交;false 需要配置真实 API Key
PAPER_TRADING=true
PAPER_INITIAL_CASH=100000
PAPER_FEE_RATE=0.001

# ===== 数据库(生产切 MySQL) =====
# 开发: sqlite+aiosqlite:///./adaptive.db
# 生产: mysql+aiomysql://root:password@localhost:3306/adaptive_trading
DATABASE_URL=sqlite+aiosqlite:///./adaptive.db

# ===== Redis(可选) =====
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ===== Web =====
API_HOST=0.0.0.0
API_PORT=8800

# ===== 币安 =====
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ===== AI Advisor =====
# provider: anthropic(默认,兼容 Claude 协议网关)或 openai
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_BASE_URL=https://virex.virexstar.com
AI_API_KEY=
AI_MODEL=glm-5.3
AI_INTERVAL_SECONDS=300
