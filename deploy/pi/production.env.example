# Pi 生产配置模板。复制到宿主机的 /etc/adaptive-trading/production.env 后编辑；绝不放回仓库。
# 启动：docker compose --env-file /etc/adaptive-trading/production.env up -d
# 该文件的权限建议：install -m 600 /dev/null /etc/adaptive-trading/production.env

# 让 compose 将本文件同时作为容器 env_file；必须是宿主机绝对路径。
ADAPTIVE_TRADING_ENV_FILE=/etc/adaptive-trading/production.env

# 所有可写数据应在 Pi 的 SSD（而非 SD 卡）上；目录须事先创建并让 Docker 可写。
HOST_DATA_DIR=/srv/adaptive-trading/data
HOST_LOGS_DIR=/srv/adaptive-trading/logs
HOST_EVIDENCE_DIR=/srv/adaptive-trading/evidence
HOST_REPORTS_DIR=/srv/adaptive-trading/reports

# V12.3: 把外置配置目录挂进容器, 使管理页面(/admin)能保存配置。
# 需要的配套权限(容器内进程为 uid 999):
#   chown -R 999:999 /etc/adaptive-trading && chmod 700 /etc/adaptive-trading
#   chmod 600 /etc/adaptive-trading/production.env
# 不设置该项时管理页面仍可读配置、可预览改动, 但「保存」会明确报不可写。
HOST_CONFIG_DIR=/etc/adaptive-trading

# 版本追溯：发布时写入实际 Git SHA；不要使用 latest。
IMAGE_TAG=CHANGE_TO_GIT_SHA
GIT_SHA=CHANGE_TO_GIT_SHA
TZ=Asia/Shanghai

# 局域网 Dashboard：端口由 compose 发布为 8800；写接口必须由强随机令牌保护。
API_HOST=0.0.0.0
API_PORT=8800
WEB_ADMIN_TOKEN=CHANGE_TO_A_LONG_RANDOM_SECRET

# 冻结产品边界与本地持久化库（compose 会覆写为 /app/data/adaptive.db）。
SYMBOLS=SOLUSDT
DATABASE_URL=sqlite+aiosqlite:////app/data/adaptive.db
LOG_LEVEL=INFO
DAILY_REPORT_ENABLED=true
AI_ENABLED=false
REDIS_ENABLED=false

# 阶段 A：Pi/测试网运行。保持纸面，直到 CC 任务中的测试网证据门槛全部通过。
PAPER_TRADING=true
BINANCE_TESTNET=true
RUN_TESTNET_TRADING=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# 主网凭证一律留空。切换真实小资金前，必须按 mainnet-prestart-checklist.md 完成所有 REQUIRED 项。
BINANCE_API_KEY=
BINANCE_API_SECRET=
LIVE_TRADING_CONFIRM=
MAINNET_READINESS_ENABLED=true
MAINNET_API_SCOPE_CONFIRM=false
MAINNET_TAKEOVER_ENABLED=true

# 首次小资金的保守风控上限：由操作者填入经书面批准的值；不得留空或沿用大额默认值。
# RISK_MAX_POSITION_PCT=
# RISK_MAX_SINGLE_ORDER_PCT=
# RISK_MAX_SOL_EXPOSURE=
# RISK_MAX_DAILY_LOSS=
# RISK_MAX_DRAWDOWN=
# RISK_INITIAL_EQUITY=

# 运行与对账安全开关；主网运行必须保持启用。
STARTUP_RECONCILE_ENABLED=true
RECONCILE_INTERVAL_SECONDS=300
EQUITY_RECONCILE_TOLERANCE_PCT=0.02
